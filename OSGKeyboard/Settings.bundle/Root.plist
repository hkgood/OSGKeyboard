<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Intentionally exposes no preferences. Its only job is to guarantee the
	     app has an entry in Settings, which is what makes
	     UIApplication.openSettingsURLString resolve to the app's own page
	     instead of dropping the user at the Settings root or app list. -->
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array/>
</dict>
</plist>
